<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Godot SDK pre-generates AssemblyInfo in .godot/mono/temp/obj/; suppress the
         standard .NET SDK auto-generation to avoid duplicate attribute errors. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!-- Core/AI live in the shared lib; server is a separate ASP.NET project.
       Exclude both to avoid duplicate type definitions and missing ASP.NET refs. -->
  <ItemGroup>
    <Compile Remove="src/Core/**/*.cs" />
    <Compile Remove="src/AI/**/*.cs" />
    <Compile Remove="server/**/*.cs" />
    <Compile Remove="shared/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="shared/RiichiMahjong.Core.csproj" />
  </ItemGroup>
</Project>