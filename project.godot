; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dolo Mahjong"
; The project was renamed from "RiichiMahjong" to "Dolo Mahjong". By default that
; repoints user:// from app_userdata/RiichiMahjong to app_userdata/Dolo Mahjong,
; which would orphan every existing player's settings, reconnection UUID and login.
; custom_user_dir_name preserves path separators, so spelling out the full default
; layout reproduces the ORIGINAL location exactly on every platform (Godot skips its
; own "Godot/app_userdata" prefix once use_custom_user_dir is on, so it must be
; written here explicitly - a bare "RiichiMahjong" would land in a new third folder).
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/RiichiMahjong"
run/main_scene="res://Scenes/IntroScreen.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://Assets/splash.png"
config/icon="res://icon.svg"

[autoload]

NetworkManager="*res://src/UI/NetworkManager.cs"
SoundManager="*res://src/UI/SoundManager.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/width=1024
window/size/height=576

[dotnet]

project/assembly_name="RiichiMahjong"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
